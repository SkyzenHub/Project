local function saveConfig()
    if not writefile then return false end
    local data = { TIER_ON = {} }
    for _, k in ipairs(SAVE_KEYS) do
        data[k] = CONFIG[k]
    end
    for t, v in pairs(CONFIG.TIER_ON) do
        data.TIER_ON[tostring(t)] = v
    end
    local ok = pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
    return ok
end

local function loadConfig()
    if not (isfile and readfile) then return false end
    local ok, data = pcall(function()
        if isfile(SAVE_FILE) then
            return HttpService:JSONDecode(readfile(SAVE_FILE))
        end
    end)
    if not ok or type(data) ~= "table" then return false end
    for _, k in ipairs(SAVE_KEYS) do
        if data[k] ~= nil and type(data[k]) == type(CONFIG[k]) then
            CONFIG[k] = data[k]
        end
    end
    if type(data.TIER_ON) == "table" then
        for t in pairs(CONFIG.TIER_ON) do
            local v = data.TIER_ON[tostring(t)]
            if type(v) == "boolean" then CONFIG.TIER_ON[t] = v end
        end
    end
    return true
end

