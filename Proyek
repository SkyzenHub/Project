local mgWatched = setmetatable({}, { __mode = "k" })
local mgLetterRef = nil
local mgLastTap = 0
local mgGuiConns = {}

local function mgVisibleChain(o)
    local cur = o
    while cur and cur:IsA("GuiObject") do
        if not cur.Visible then return false end
        cur = cur.Parent
    end
    local sg = o:FindFirstAncestorOfClass("ScreenGui")
    return sg == nil or sg.Enabled
end

-- #F3D27A = R0.95 G0.82 B0.48 -> lolos
local function mgIsGold(c)
    return c.R >= 0.88 and c.G >= 0.62 and c.B <= 0.58 and (c.R - c.B) >= 0.30
end

local function mgDoTap(reason)
    if not (CONFIG.ENABLED and CONFIG.MG_TAP) then return end
    local now = os.clock()
    if now - mgLastTap < 0.25 then return end
    mgLastTap = now

    local lbl = mgLetterRef
    if not (lbl and lbl.Parent and mgVisibleChain(lbl)) then return end

    task.spawn(function()
        local letter = string.upper(string.sub(lbl.Text, 1, 1))

        local tapBtn, cur = nil, lbl
        for _ = 1, 6 do
            if cur and cur.Name == "Tap" then tapBtn = cur break end
            cur = cur and cur.Parent
        end
        if not tapBtn and lbl.Parent then
            local root = lbl.Parent
            for _ = 1, 4 do
                local f = root:FindFirstChild("Tap", true)
                if f then tapBtn = f break end
                root = root.Parent
            end
        end

        if tapBtn and firesignal then
            for _, sig in ipairs({ "MouseButton1Down", "MouseButton1Click", "Activated", "MouseButton1Up" }) do
                pcall(function() firesignal(tapBtn[sig]) end)
            end
        end

        if VIM then
            local target = tapBtn or lbl
            local pos = target.AbsolutePosition + target.AbsoluteSize / 2
            local sg = target:FindFirstAncestorOfClass("ScreenGui")
            if sg and not sg.IgnoreGuiInset then
                pos = pos + game:GetService("GuiService"):GetGuiInset()
            end
            local okK, kc = pcall(function() return Enum.KeyCode[letter] end)
            if okK and kc then
                pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
                task.wait(0.02)
