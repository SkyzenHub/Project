-- Heavenly Tribulation (petir + cincin): auto ABSORB tepat waktu
local tribConn = nil
local tribBusy = false
local tribBusyAt = 0

local function tribOnEvent(id, action, plr, a3, a4)
    if plr ~= LocalPlayer then return end
    if not (CONFIG.ENABLED and CONFIG.BREAKTHROUGH and btId == id) then return end

    if action == "gather" then
        tribBusy = true
        tribBusyAt = os.clock()
    elseif action == "end" then
        tribBusy = false
    elseif action == "bolt" then
        local index, target = a3, a4
        if type(index) ~= "number" or type(target) ~= "number" then return end
        tribBusy = true
        tribBusyAt = os.clock()

        task.spawn(function()
            local lead = CONFIG.TRIB_LEAD / 1000
            local okT, nowT = pcall(function() return workspace:GetServerTimeNow() end)
            local delta
            local wait

            if okT and math.abs(target - nowT) < 10 then
                wait = target - lead - nowT
            else
                -- waktu server tidak cocok: pakai perkiraan (cincin kena sekitar 1.1 dtk setelah bolt)
                wait = 1.1 - lead
            end

            if wait > 0 then task.wait(wait) end
            if not (CONFIG.ENABLED and CONFIG.BREAKTHROUGH and btId == id) then return end

            if okT and math.abs(target - nowT) < 10 then
                delta = workspace:GetServerTimeNow() - target
            else
                delta = -lead
            end

            local ev = getCultivationEvent("Tribulation")
            if ev then
                pcall(function() ev:FireServer("absorb", index, delta) end)
            end
        end)
    end
end

local function setBreakthrough(v)
    CONFIG.BREAKTHROUGH = v
    btId = btId + 1
    if btConn then
        btConn:Disconnect()
        btConn = nil
    end
    if tribConn then
        pcall(function() tribConn:Disconnect() end)
        tribConn = nil
    end
    tribBusy = false
    if not v then return end
    local id = btId

    local miniEv = getCultivationEvent("StartBreakthroughMinigame")
    if miniEv then
        btConn = miniEv.OnClientEvent:Connect(function()
            miniSeen = true
            task.spawn(function()
                task.wait(CONFIG.BT_DELAY)
                if CONFIG.ENABLED and CONFIG.BREAKTHROUGH and btId == id then
                    sendBreakthroughResult()
                end
            end)
        end)
    end

    local tribEv = getCultivationEvent("Tribulation")
    if tribEv then
        tribConn = tribEv.OnClientEvent:Connect(function(action, plr, a3, a4)
            tribOnEvent(id, action, plr, a3, a4)
        end)
    end

    task.spawn(function()
        while CONFIG.ENABLED and CONFIG.BREAKTHROUGH and btId == id do
            if tribBusy and os.clock() - tribBusyAt > 90 then tribBusy = false end

            if not tribBusy then
                miniSeen = false
                local startEv = getCultivationEvent("Breakthrough")
                if startEv then pcall(function() startEv:FireServer() end) end
                bodyBreakthroughOnce()

                local waited = 0
                while not miniSeen and waited < 3 and CONFIG.BREAKTHROUGH and btId == id do
                    task.wait(0.1)
                    waited = waited + 0.1
                end

                if miniSeen then
                    task.wait(CONFIG.BT_DELAY + 1)
                elseif CONFIG.BREAKTHROUGH and btId == id and not tribBusy then
                    task.wait(CONFIG.BT_DELAY)
                    sendBreakthroughResult()
                end
            end

            task.wait(CONFIG.BT_INTERVAL)
        end
    end)
end

