local function moveTo(hrp, pos, id)
    local cf = CFrame.new(pos + Vector3.new(0, 3, 0))
    local dist = (hrp.Position - cf.Position).Magnitude
    if dist < 5 then
        hrp.CFrame = cf
        return true
    end

    local t = math.max(dist / CONFIG.TWEEN_SPEED, 0.02)
    local tw = TS:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {CFrame = cf})
    local done = false
    local conn = tw.Completed:Connect(function() done = true end)
    tw:Play()

    while not done and CONFIG.TWEEN_FARM and tweenId == id do
        task.wait(0.01)
    end
    conn:Disconnect()

    if not done then
        tw:Cancel()
        return false
    end
    hrp.CFrame = cf
    return true
end

local function findTweenTarget(spots)
    for _, tier in ipairs(activeTiers()) do
        for _, spot in ipairs(spots:GetChildren()) do
            if spot.Parent and spot:GetAttribute("HerbYear") == tier
                and not (skipUntil[spot] and skipUntil[spot] > os.clock()) then
                local prompt = spot:FindFirstChild("CollectHerbPrompt", true)
                local pos = getPos(spot)
                if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled and pos then
                    return spot, prompt, pos, tier
                end
            end
        end
    end
end

local function tweenLoop(id)
    local purged = false
    while CONFIG.ENABLED and CONFIG.TWEEN_FARM and tweenId == id do
        local spots = workspace:FindFirstChild("HerbSpots")
        if not spots then
            task.wait(1)
        else
            hookSpots(spots)
            if CONFIG.PURGE and not purged then
                purged = true
                purgeMap(spots)
            end

            local spot, prompt, pos = findTweenTarget(spots)
            if spot then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if moveTo(hrp, pos, id) and CONFIG.TWEEN_FARM and tweenId == id then
                        task.wait(0.2)

                        local collected = false
                        for _ = 1, 4 do
                            if not (CONFIG.TWEEN_FARM and tweenId == id) then break end
                            if not (spot.Parent and prompt.Parent and prompt.Enabled) then
                                collected = true
                                break
                            end
                            pcall(function() fireproximityprompt(prompt) end)
                            VIM:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                            task.wait(0.02)
                            VIM:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                            pcall(function()
                                prompt:InputHoldBegin()
                                task.wait(0.05)
                                prompt:InputHoldEnd()
                            end)
                            task.wait(0.25)
                        end

                        if not collected and CONFIG.TWEEN_FARM and tweenId == id
                            and spot.Parent and prompt.Parent and prompt.Enabled then
                            skipUntil[spot] = os.clock() + 5
                        end
                    end
                else
                    task.wait(0.5)
                end
            else
                task.wait(CONFIG.SCAN_DELAY / 1000)
            end
        end
    end
end

local function setTweenFarm(v)
    CONFIG.TWEEN_FARM = v
    tweenId = tweenId + 1

    local sf = getSwordFlight()
    if sf then
        pcall(function() sf:FireServer(v) end)
    end

    if v then
        task.spawn(tweenLoop, tweenId)
    end
end

-- ESP Herb
local espHerbs = {}
local espLoopId = 0
local TIER_COLORS = {
    [1000] = Color3.fromRGB(255, 215, 0),
    [100] = Color3.fromRGB(180, 90, 255),
    [10] = Color3.fromRGB(80, 160, 255),
    [1] = Color3.fromRGB(90, 255, 120),
}

local function clearEspHerbs()
    for _, d in pairs(espHerbs) do
        pcall(function() d.bb:Destroy() end)
    end
    espHerbs = {}
end

local function addHerbEsp(spot, tier)
    local adornee = spot:IsA("BasePart") and spot or spot:FindFirstChildWhichIsA("BasePart", true)
    if not adornee then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "HerbESP"
    bb.Size = UDim2.new(0, 160, 0, 24)
    bb.AlwaysOnTop = true
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
    bb.Adornee = adornee
    bb.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = TIER_COLORS[tier] or Color3.new(1, 1, 1)
    label.TextStrokeTransparency = 0
    label.Text = "Tier " .. tostring(tier)
    label.Parent = bb

    espHerbs[spot] = { bb = bb, label = label }
end

local function setEspHerb(v)
    CONFIG.ESP_HERB = v
    espLoopId = espLoopId + 1
    clearEspHerbs()
    if not v then return end

    local id = espLoopId
    task.spawn(function()
        while CONFIG.ENABLED and CONFIG.ESP_HERB and espLoopId == id do
            local spots = workspace:FindFirstChild("HerbSpots")
            if spots then
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                local seen = {}

                for _, spot in ipairs(spots:GetChildren()) do
                    local tier = spot:GetAttribute("HerbYear")
                    local prompt = tier and spot:FindFirstChild("CollectHerbPrompt", true)
                    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        seen[spot] = true
                        local d = espHerbs[spot]
                        if not d or not d.bb.Parent then
                            addHerbEsp(spot, tier)
                            d = espHerbs[spot]
                        end
                        if d then
                            local text = "Tier " .. tostring(tier)
                            local pos = getPos(spot)
                            if myRoot and pos then
                                text = text .. " | " .. math.floor((pos - myRoot.Position).Magnitude) .. "m"
                            end
                            d.label.Text = text
                        end
                    end
                end

                local stale = {}
                for spot in pairs(espHerbs) do
                    if not seen[spot] then stale[#stale + 1] = spot end
                end
                for _, spot in ipairs(stale) do
                    pcall(function() espHerbs[spot].bb:Destroy() end)
                    espHerbs[spot] = nil
                end
            end
            task.wait(0.3)
        end
        if espLoopId == id then clearEspHerbs() end
    end)
end

-- ESP Player
local espPlayers = {}
local espPlayerLoop = nil
local PLAYER_ESP_COLOR = Color3.fromRGB(64, 224, 255)

local function removePlayerEsp(plr)
    local d = espPlayers[plr]
    if d then
        pcall(function() d.hl:Destroy() end)
        pcall(function() d.bb:Destroy() end)
        espPlayers[plr] = nil
    end
end

local function getEspRoot(char)
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head")
end

local function buildPlayerEsp(plr, char, root)
    local hl = Instance.new("Highlight")
    hl.Adornee = char
    hl.FillColor = PLAYER_ESP_COLOR
    hl.FillTransparency = 0.8
    hl.OutlineColor = PLAYER_ESP_COLOR
    hl.OutlineTransparency = 0.1
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = char

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 24)
    bb.Adornee = root
    bb.AlwaysOnTop = true
    bb.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
    bb.Parent = char

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.TextColor3 = PLAYER_ESP_COLOR
    label.TextStrokeTransparency = 0
    label.Text = plr.Name
    label.Parent = bb

    local d = { hl = hl, bb = bb, label = label, char = char }
    espPlayers[plr] = d
    return d
end

local function setEspPlayers(v)
    CONFIG.ESP_PLAYERS = v
    if espPlayerLoop then
        espPlayerLoop:Disconnect()
        espPlayerLoop = nil
    end
    local list = {}
    for plr in pairs(espPlayers) do list[#list + 1] = plr end
    for _, plr in ipairs(list) do removePlayerEsp(plr) end

    if not v then return end

    local acc = 0
    espPlayerLoop = RunService.Heartbeat:Connect(function(dt)
        acc = acc + dt
        if acc < 0.3 then return end
        acc = 0

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local present = {}

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                present[plr] = true
                local char = plr.Character
                local root = char and getEspRoot(char)
                local d = espPlayers[plr]
                if root then
                    if not d or d.char ~= char or not d.hl.Parent or not d.bb.Parent then
                        removePlayerEsp(plr)
                        d = buildPlayerEsp(plr, char, root)
                    end
                    if myRoot then
                        d.label.Text = plr.Name .. " | " .. math.floor((root.Position - myRoot.Position).Magnitude) .. "m"
                    else
                        d.label.Text = plr.Name
                    end
                elseif d then
                    removePlayerEsp(plr)
                end
            end
        end

        local gone = {}
        for plr in pairs(espPlayers) do
            if not present[plr] then gone[#gone + 1] = plr end
        end
        for _, plr in ipairs(gone) do removePlayerEsp(plr) end
    end)
end

