local execQueued = false

local function getQueueFn()
    return queue_on_teleport
        or (syn and syn.queue_on_teleport)
        or (fluxus and fluxus.queue_on_teleport)
end

local function buildQueueCode()
    local src = CONFIG.SCRIPT_SRC
    local load
    if src:match("^https?://") then
        load = string.format("loadstring(game:HttpGet(%q))()", src)
    else
        local f = (src ~= "" and src) or SCRIPT_FILE
        load = string.format("loadstring(readfile(%q))()", f)
    end
    return "if not game:IsLoaded() then game.Loaded:Wait() end "
        .. "task.wait(2) "
        .. "local g = (getgenv and getgenv()) or _G "
        .. "g.SkyZenQueuedRun = true "
        .. load
end

local function setAutoExec(v)
    CONFIG.AUTO_EXEC = v
    if v and not execQueued then
        local q = getQueueFn()
        if q then
            local ok = pcall(q, buildQueueCode())
            if ok then
                execQueued = true
                notify("Auto Executor", "Aktif. Script jalan otomatis setelah teleport.")
            else
                notify("Auto Executor", "Gagal mengantri script.")
            end
        else
