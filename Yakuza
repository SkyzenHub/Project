local function refreshToggleLabel()
	if not isRunning then
		toggleButton.Text = "Auto Aura: OFF"
		toggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	else
		toggleButton.BackgroundColor3 = Color3.fromRGB(50, 180, 80)
		if autoMode == "nearest_name" then
			toggleButton.Text = lockedTargetName and ("ON (" .. lockedTargetName .. ")") or "ON (Nearest Name)"
		else
			toggleButton.Text = "ON (All Mobs)"
		end
	end
end

local function refreshModeLabel()
	if autoMode == "nearest_name" then
		modeButton.Text = "Mode: Nearest Name"
	else
		modeButton.Text = "Mode: All Mobs"
	end
end

-- Klik Tombol Mode untuk berpindah otomatis
modeButton.MouseButton1Click:Connect(function()
	if autoMode == "nearest_name" then
		autoMode = "all_mobs"
		lockedTargetName = nil
	else
		autoMode = "nearest_name"
		lockedTargetName = autoDetectNearestNpcName()
	end
	refreshModeLabel()
	refreshToggleLabel()
end)

-- Klik Tombol On/Off
toggleButton.MouseButton1Click:Connect(function()
	isRunning = not isRunning

	if isRunning then
		if autoMode == "nearest_name" then
			lockedTargetName = autoDetectNearestNpcName()
		end
		refreshToggleLabel()

		task.spawn(function()
			while isRunning do
				if autoMode == "nearest_name" then
					refreshToggleLabel()
				end

				local targets = getTargetsInAura()
				for _, target in ipairs(targets) do
					if not isRunning then break end
					pcall(function()
						AuraEvent:FireServer(target)
					end)
				end
				task.wait(intervalSerang)
			end
		end)
	else
		lockedTargetName = nil
		refreshToggleLabel()
		auraRing.Parent = nil
	end
end)
