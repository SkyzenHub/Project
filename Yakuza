auraRing.Parent = nil

-- Update posisi ring di bawah kaki karakter saat aktif
RunService.RenderStepped:Connect(function()
	if not isRunning then
		if auraRing.Parent ~= nil then
			auraRing.Parent = nil
		end
		return
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if rootPart and humanoid and humanoid.Health > 0 then
		if auraRing.Parent ~= Workspace then
			auraRing.Parent = Workspace
		end

		local hipHeight = humanoid.HipHeight > 0 and humanoid.HipHeight or 2
		local groundY = rootPart.Position.Y - hipHeight - 0.8
		auraRing.CFrame = CFrame.new(rootPart.Position.X, groundY, rootPart.Position.Z)
			* CFrame.Angles(0, 0, math.rad(90))
	else
		auraRing.Parent = nil
	end
end)

-- Fungsi mengambil target yang sesuai mode otomatis
local function getTargetsInAura()
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return {} end

	if autoMode == "nearest_name" and not lockedTargetName then
		lockedTargetName = autoDetectNearestNpcName()
	end

	local targets = {}

	for _, objek in ipairs(mobFolder:GetDescendants()) do
		local ok, npcRoot = isValidLivingNpc(objek, character)
		if ok and npcRoot then
			local nameMatches = (autoMode == "all_mobs") or (lockedTargetName == nil) or (objek.Name == lockedTargetName)
			if nameMatches then
				local jarak = (rootPart.Position - npcRoot.Position).Magnitude
				if jarak <= auraRadius then
					table.insert(targets, objek)
				end
			end
		end
	end

	-- Jika target terkunci sudah habis di area manapun, cari otomatis nama NPC terdekat baru
	if autoMode == "nearest_name" and lockedTargetName and #targets == 0 then
		local stillExistsSomewhere = false
		for _, objek in ipairs(mobFolder:GetDescendants()) do
			local ok = isValidLivingNpc(objek, character)
			if ok and objek.Name == lockedTargetName then
				stillExistsSomewhere = true
				break
			end
		end
		if not stillExistsSomewhere then
			lockedTargetName = autoDetectNearestNpcName()
		end
	end

	return targets
end

