local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

-- Fungsi helper untuk menempatkan GUI dengan aman di executor
local function getGuiParent()
	if typeof(gethui) == "function" then
		local ok, hui = pcall(gethui)
		if ok and hui then
			return hui
		end
	end
	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		return coreGui
	end
	return player:WaitForChild("PlayerGui")
end

local guiParent = getGuiParent()

-- Bersihkan instance lama jika script dijalankan ulang
for _, name in ipairs({ "KillAuraGui", "KillAuraRing" }) do
	local oldGui = guiParent:FindFirstChild(name)
	if oldGui then oldGui:Destroy() end
	local oldRing = Workspace:FindFirstChild(name)
	if oldRing then oldRing:Destroy() end
end

-- SESUAIKAN REMOTE EVENT SERANGAN DENGAN GAME ANDA
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local AuraEvent = Remotes:WaitForChild("Attack") -- Ganti sesuai nama RemoteEvent serangan

-- Konfigurasi Kill Aura Otomatis
local isRunning = false
local auraRadius = 30 -- Radius jangkauan kill aura (dalam studs)
local intervalSerang = 0.1 -- Jeda antar siklus serangan (detik)
local mobFolder = Workspace -- Ganti ke Workspace:WaitForChild("Mobs") jika ada folder khusus
local ringColor = Color3.fromRGB(255, 70, 70)

-- Mode: "nearest_name" (kunci nama NPC terdekat) atau "all_mobs" (serang semua NPC hidup di radius)
local autoMode = "nearest_name"
local lockedTargetName = nil

-- Fungsi memeriksa apakah model adalah NPC hidup yang valid
local function isValidLivingNpc(objek: Instance, character: Model?): (boolean, BasePart?)
	if not objek:IsA("Model") or objek == character then
		return false, nil
	end
	if Players:GetPlayerFromCharacter(objek) then
		return false, nil
	end

	local humanoid = objek:FindFirstChildOfClass("Humanoid")
	local npcRoot = objek:FindFirstChild("HumanoidRootPart") or objek.PrimaryPart
	if humanoid and npcRoot and humanoid.Health > 0 then
		return true, npcRoot
	end

	return false, nil
end

-- Fungsi mencari nama NPC terdekat secara otomatis
local function autoDetectNearestNpcName()
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end

	local bestName = nil
	local shortestDistance = math.huge

	for _, objek in ipairs(mobFolder:GetDescendants()) do
		local ok, npcRoot = isValidLivingNpc(objek, character)
		if ok and npcRoot then
			local dist = (rootPart.Position - npcRoot.Position).Magnitude
			if dist < shortestDistance then
				shortestDistance = dist
				bestName = objek.Name
			end
		end
	end

	return bestName
end

-- Membuat Part Ring Transparan
local auraRing = Instance.new("Part")
auraRing.Name = "KillAuraRing"
auraRing.Shape = Enum.PartType.Cylinder
auraRing.Material = Enum.Material.Neon
