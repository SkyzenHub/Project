end

local function fn3()
    local tbl3 = {}
    for i, descendant in ipairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant:GetAttribute("Occupied") ~= nil then
            table.insert(tbl3, descendant)
        end
