local function fn21()
    fn20()
    fn18()
    connection2 = RunService.Heartbeat:Connect(function()
        if not CONFIG.BALL_TRAJECTORY then return fn20() end
        local ok, result = pcall(fn8)
        if ok and result and typeof(result.ballPos) == "Vector3" and typeof(result.landingPos) == "Vector3" and result.timeLeft > 0 then
            local v3 = fn9(result)
