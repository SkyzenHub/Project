    return tbl3
end

local function fn4(arg, arg2)
    if not arg then return nil end
    for i, v3 in ipairs(arg) do
        local v4 = v3.CFrame:PointToObjectSpace(arg2)
        if math.abs(v4.X) <= v3.Size.X / 2 and math.abs(v4.Z) <= v3.Size.Z / 2 then return v3 end
    end
    return nil
end

local function fn5(arg, arg2)
    local n = arg.Size.X * 0.5
    local n2 = arg.Size.Z * 0.5
    local tbl3 = {
        Vector3.new(-n, 0, -n2),
        Vector3.new(n, 0, -n2),
        Vector3.new(-n, 0, n2),
        Vector3.new(n, 0, n2),
    }
    local position = arg.Position
    local huge = math.huge
    for i, v3 in ipairs(tbl3) do
        local v4 = arg.CFrame:PointToWorldSpace(v3)
        local magnitude = (Vector3.new(v4.X, 0, v4.Z) - Vector3.new(arg2.X, 0, arg2.Z)).Magnitude
        if magnitude < huge then huge = magnitude position = v4 end
    end
    return position
end

local function fn6(arg)
    local v3 = nil
    local huge = math.huge
    for i, descendant in ipairs(workspace:GetDescendants()) do
        if descendant.Name == "BallShadow" and descendant:IsA("BasePart") then
            local magnitude = (descendant.Position - arg).Magnitude
            if magnitude < huge then huge = magnitude v3 = descendant end
        end
    end
    return v3, huge
end

local function fn7(arg, arg2, arg3)
    local v3 = nil
    local huge = math.huge
    for i, v4 in ipairs(arg) do
        if v4 ~= arg2 then
            local magnitude = (v4.Position - arg3).Magnitude
            if magnitude < huge then huge = magnitude v3 = v4 end
        end
    end
    return v3
end

local function fn8()
    local v3 = fn2()
    if not v3 then return nil end
    local attribute = LocalPlayer:GetAttribute("InRound")
    local str = attribute or "Main"
    local balls = v3._balls
    local v4 = balls and v3._balls[str]
    local state = v4 and v4.State
    if not state or state.Dead or not state.EndTime then return nil end
    local serverTimeNow = workspace:GetServerTimeNow()
    local n = math.max(state.EndTime - serverTimeNow, 0)
    local vector = typeof(Ball.VelocityAt) == "function" and Ball.VelocityAt(state, serverTimeNow) or Vector3.zero
    local magnitude = typeof(vector) == "Vector3" and vector.Magnitude or 0
    local flag = typeof(Ball.At) == "function" and Ball.At(state, serverTimeNow) or nil
    local flag2 = typeof(Ball.At) == "function" and Ball.At(state, state.EndTime) or nil
    return {
        state = state, now = serverTimeNow, vel = vector, speed = magnitude,
        timeLeft = n, ballPos = flag, landingPos = flag2, zones = v4.Zones,
    }
end

local function fn9(arg)
    local tbl3 = {}
    local ballPos = arg.ballPos
    local landingPos = arg.landingPos
    local timeLeft = arg.timeLeft
    if typeof(ballPos) ~= "Vector3" or typeof(landingPos) ~= "Vector3" or timeLeft <= 0 then return tbl3 end
    local endTime = typeof(Ball.At) == "function" and arg.state and arg.now and arg.state.EndTime
    local flag = typeof(arg.vel) == "Vector3" and arg.vel.Y > 2
    for i = 0, 18 do
        local n = i / 18
        local vector = nil
        if endTime then
            local ok, result = pcall(Ball.At, arg.state, arg.now + timeLeft * n)
            if ok and typeof(result) == "Vector3" then vector = result end
        end
        if not vector then
            local v3 = ballPos:Lerp(landingPos, n)
            local n2 = flag and math.sin(n * math.pi) * math.clamp(arg.vel.Y * timeLeft * 0.25, 1.5, 14) or 0
            vector = Vector3.new(v3.X, v3.Y + n2, v3.Z)
        end
        table.insert(tbl3, vector)
    end
    return tbl3
end

local function fn10(arg)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, folder}
    local vector = Vector3.new(arg.X, arg.Y + 4, arg.Z)
    local hit = workspace:Raycast(vector, Vector3.new(0, -40, 0), raycastParams)
    if not hit then return Vector3.new(arg.X, arg.Y, arg.Z) end
    return hit.Position + Vector3.new(0, 0.04, 0)
end

local function fn11(arg, arg2)
    local v3 = fn5(arg2, arg.Position)
    local v4 = arg2.Position:Lerp(v3, 0.9)
    local vector = Vector3.new(v4.X - arg.Position.X, -0.15, v4.Z - arg.Position.Z)
    if vector.Magnitude > 0 and reHitBall then
        reHitBall:FireServer("Spike", vector.Unit, arg.Position, workspace:GetServerTimeNow())
    end
end

local function fn12(arg, arg2)
    local v3 = fn2()
    if not v3 then return end
    local balls = v3._balls
    local v4 = balls
    if balls then
        local balls2 = v3._balls
        local attribute = LocalPlayer:GetAttribute("InRound")
        local str = attribute or "Main"
        v4 = balls2[str]
    end
    local state = v4 and v4.State
    if not state or state.Dead or not state.EndTime then return end
    local zones = v4.Zones
    local v5 = zones or fn3()
    local v6 = fn4(v5, arg.Position)
    if not v6 then return end
    local v7 = Ball.At(state, state.EndTime)
    if typeof(v7) ~= "Vector3" or not fn4({v6}, v7) then return end
    local n = state.EndTime - workspace:GetServerTimeNow()
    local n2 = arg2 or 0.45
    if n2 >= n and n >= -0.05 then return v7, v6, state.EndTime, n end
end

