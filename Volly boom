end

local function fn16(arg)
    fn14()
    local character = LocalPlayer.Character
    local humanoidRootPart = character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    local cframe = CFrame.new(arg)
    connection = RunService.Heartbeat:Connect(function(deltaTime)
        if not CONFIG.TO_BALL_SPOT or fn13() ~= "Tween" or ConfigLocked or not humanoidRootPart.Parent then
            return fn14()
        end
        local magnitude = (cframe.Position - humanoidRootPart.Position).Magnitude
        if magnitude < 0.5 then
            humanoidRootPart.CFrame = cframe
            return fn14()
        end
        humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
        humanoidRootPart.CFrame = humanoidRootPart.CFrame:Lerp(cframe, math.min(70 * deltaTime / magnitude, 1))
    end)
end

local function fn17(arg)
    fn14()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp or humanoid.Health <= 0 then return end

    if not _G.VB_OriginalWalkSpeed then
        _G.VB_OriginalWalkSpeed = humanoid.WalkSpeed
    end

    humanoid.WalkSpeed = CONFIG.WALK_SPEED
    humanoid:MoveTo(arg)

    if _G.VB_WalkRestoreConn then
        _G.VB_WalkRestoreConn:Disconnect()
        _G.VB_WalkRestoreConn = nil
    end
    _G.VB_WalkRestoreConn = RunService.Heartbeat:Connect(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then
            if _G.VB_WalkRestoreConn then _G.VB_WalkRestoreConn:Disconnect() _G.VB_WalkRestoreConn = nil end
            return
