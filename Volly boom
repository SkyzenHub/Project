local function startAutoSpike()
    task.spawn(function()
        while CONFIG.AUTO_SPIKE and not ConfigLocked do
            task.wait(0.05)
            pcall(function()
                local character = LocalPlayer.Character
                local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if not humanoidRootPart or not humanoid or not reHitBall then return end
                local v3, v4 = fn6(humanoidRootPart.Position)
                local v5 = fn8()
                local flag = false
                if v5 then
                    local flag2 = v5.speed >= 95 or v5.timeLeft <= 0.5
                    flag = flag2
                end
                if not flag then
                    if v4 >= 11 then return end
                    local zones = v5 and v5.zones or fn3()
                    local v6 = fn4(zones, humanoidRootPart.Position)
                    if not v6 then return end
                    local landingPos = v5 and v5.landingPos
                    local flag2 = landingPos and fn4({v6}, landingPos) ~= nil or false
                    local flag3 = v5 and v5.ballPos and humanoidRootPart.Position.Y + 4 < v5.ballPos.Y or false
                    if flag2 or flag3 then
                        if humanoid.FloorMaterial ~= Enum.Material.Air then
                            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                            local n = 0.12
                            if v5 and v5.timeLeft > 0 then
                                n = math.clamp(v5.timeLeft * 0.45, 0.06, 0.25)
                            end
                            task.wait(n)
                        end
                        local character2 = LocalPlayer.Character
                        local humanoidRootPart2 = character2 and character2:FindFirstChild("HumanoidRootPart")
                        local v7 = humanoidRootPart2
                        if not humanoidRootPart2 then return end
                        local v8 = fn7(zones, v6, v7.Position)
                        if v8 then fn11(v7, v8) end
                    end
                    return
                end
                if v4 >= 7 then return end
                local zones = v5 and v5.zones or fn3()
                local v6 = fn7(zones, fn4(zones, humanoidRootPart.Position), humanoidRootPart.Position)
                if v6 then fn11(humanoidRootPart, v6) end
            end)
        end
    end)
end

local function startToBallSpot()
    task.spawn(function()
        local flag = false
        local v3 = nil
        while CONFIG.TO_BALL_SPOT and not ConfigLocked do
            task.wait(0.02)
            pcall(function()
                local character = LocalPlayer.Character
                local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if not humanoidRootPart or not humanoid then return end
                local v4 = fn13()
                local n = v4 == "Walk" and 1.1 or 0.45
                local v5, v6, v7 = fn12(humanoidRootPart, n)
                if v7 ~= v3 then v3 = v7 flag = false end
                if v5 and v6 and not flag then
                    flag = true
                    if v4 == "Walk" then
                        fn17(v5)
                    else
                        fn16(Vector3.new(v5.X, v6.Position.Y + v6.Size.Y / 2 + 3, v5.Z))
                    end
                elseif not v5 then
                    flag = false
                end
            end)
        end
        fn15()
    end)
end

