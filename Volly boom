        end
    end
end

local function fn2()
    if v2 then return v2 end
    v2 = fn(function(arg)
        local value = rawget(arg, "_balls")
        local flag = value and type(arg.SetState) == "function"
        return flag
    end)
    if v2 then return v2 end
    for i, descendant in ipairs(LocalPlayer:GetDescendants()) do
        if descendant:IsA("ModuleScript") and descendant.Name == "BallController" then
            local ok, result = pcall(require, descendant)
            if ok then v2 = result return result end
