task.spawn(function()
    while true do
        task.wait(0.2)
        if state.inMatch and state.deadline > 0 and CONFIG.SHOW_TIMER then
            local sisa = state.deadline - os.clock()
            if sisa > 0 then
                timerLabel.Text = string.format("⏱ %.1f detik", sisa)
                timerLabel.TextColor3 = (sisa < 5) and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(255, 200, 100)
            else
                timerLabel.Text = "⏱ Waktu habis!"
            end
        else
            timerLabel.Text = ""
        end
    end
end)

-- ============== HANDLER UPDATE ==============
RemoteUpdate.OnClientEvent:Connect(function(data)
    if type(data) ~= "table" then return end

    if data.tipe == "menunggu" then
        state.menunggu = true
        statusLabel.Text = "🔍 " .. tostring(data.pesan)

    elseif data.tipe == "matchMulai" then
        bersihkanLog()
        state.inMatch = true
        state.menunggu = false
        state.namaKamu = data.namaKamu
        state.namaLawan = data.namaLawan
        state.matchId = data.matchId
        scoreFrame.Visible = true
        kamuLabel.Text = "Kamu\n0"
        lawanLabel.Text = data.namaLawan .. "\n0"
        kataTerakhirLabel.Text = "Kata: " .. tostring(data.kataPembuka)
        hurufLabel.Text = "Huruf sambung: " .. tostring(data.hurufSambung):upper()
        state.deadline = os.clock() + (data.waktu or 20)
        tambahLog("🎮 Match dimulai! Lawan: " .. data.namaLawan, Color3.fromRGB(255, 220, 100))
        tambahLog("Kata pembuka: " .. data.kataPembuka, Color3.fromRGB(220, 220, 220))
        cariBtn.Text = "❌ Batal Cari"
        setGiliran(data.giliranKamu)
        selectTab("Game")

    elseif data.tipe == "kata" then
        local siapa = tostring(data.siapa)
        local warna = (siapa == state.namaKamu)
            and Color3.fromRGB(120, 255, 150)
            or Color3.fromRGB(255, 150, 200)
        tambahLog(string.format("[%s] %s", siapa, tostring(data.kata)), warna)
        kataTerakhirLabel.Text = "Kata: " .. tostring(data.kata)
        hurufLabel.Text = "Huruf sambung: " .. tostring(data.hurufSambung):upper()
        if data.skor then
            kamuLabel.Text = "Kamu\n" .. tostring(data.skor[1])
            lawanLabel.Text = state.namaLawan .. "\n" .. tostring(data.skor[2])
        end
        state.deadline = os.clock() + (data.waktu or 20)
        if data.giliranKamu ~= nil then
            setGiliran(data.giliranKamu)
        end

    elseif data.tipe == "selesai" then
        state.inMatch = false
        state.menunggu = false
        state.deadline = 0
        scoreFrame.Visible = false
        cariBtn.Text = "🔍 Cari Lawan"
        setGiliran(false)
        inputBox.TextEditable = false
        timerLabel.Text = ""
        tambahLog("🏁 SELESAI! Pemenang: " .. tostring(data.pemenang), Color3.fromRGB(255, 220, 100))
        tambahLog("Alasan: " .. tostring(data.alasan), Color3.fromRGB(200, 200, 200))
        if data.skor then
            tambahLog(string.format("Skor — Kamu: %d | Lawan: %d", data.skor[1], data.skor[2]), Color3.fromRGB(180, 180, 255))
        end
        statusLabel.Text = (data.pemenang == state.namaKamu) and "🎉 KAMU MENANG!" or "💀 Kamu kalah."
        statusLabel.TextColor3 = (data.pemenang == state.namaKamu)
            and Color3.fromRGB(120, 255, 150)
            or Color3.fromRGB(255, 120, 120)
    end
end)

