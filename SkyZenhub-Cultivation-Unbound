    for i = 1, 3 do
        local scanLine = Instance.new("Frame")
        scanLine.Size = UDim2.new(1, 0, 0, 6)
        scanLine.Position = UDim2.new(0, 0, (i - 1) * 0.33, 0)
        scanLine.BackgroundColor3 = Color3.fromRGB(255, 30, 30)
        scanLine.BackgroundTransparency = 0.25
        scanLine.BorderSizePixel = 0
        scanLine.ZIndex = 100
        scanLine.Parent = overlay
        local sg = Instance.new("UIGradient", scanLine)
        sg.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0),
            NumberSequenceKeypoint.new(1, 1),
        })
        TS:Create(scanLine, TweenInfo.new(2 + i * 0.3, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, true), {Position = UDim2.new(0, 0, 1, -6)}):Play()
    end

    -- ===== glitch dots merah (24, lebih gede) =====
    for i = 1, 24 do
        local dot = Instance.new("Frame")
        local w = math.random(6, 18)
        local h = math.random(6, 18)
        dot.Size = UDim2.new(0, w, 0, h)
        dot.Position = UDim2.new(math.random(), 0, math.random(), 0)
        dot.BackgroundColor3 = Color3.fromRGB(255, 40, 40)
        dot.BackgroundTransparency = math.random(10, 50) / 100
        dot.BorderSizePixel = 0
        dot.ZIndex = 100
        dot.Parent = overlay
        task.spawn(function()
            while dot.Parent do
                task.wait(math.random(0.3, 1.5))
                dot.Position = UDim2.new(math.random(), 0, math.random(), 0)
                dot.BackgroundTransparency = math.random(10, 50) / 100
            end
        end)
    end

    -- ===== garis horizontal tebel random (strobe) =====
    for i = 1, 5 do
        task.spawn(function()
            local line = Instance.new("Frame")
            line.Size = UDim2.new(1, 0, 0, math.random(2, 5))
            line.Position = UDim2.new(0, 0, math.random(), 0)
            line.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            line.BackgroundTransparency = 0
            line.BorderSizePixel = 0
            line.ZIndex = 100
            line.Parent = overlay
            while line.Parent do
                line.Position = UDim2.new(0, 0, math.random(), 0)
                line.Size = UDim2.new(1, 0, 0, math.random(2, 5))
                task.wait(math.random(1, 4))
            end
