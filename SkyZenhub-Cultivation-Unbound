    descLbl.TextColor3 = Color3.fromRGB(240, 240, 250)
    descLbl.ZIndex = 102
    descLbl.Parent = panel

    -- tombol
    local okBtn = Instance.new("TextButton")
    okBtn.AnchorPoint = Vector2.new(0.5, 0)
    okBtn.Position = UDim2.new(0.5, 0, 1, -80)
