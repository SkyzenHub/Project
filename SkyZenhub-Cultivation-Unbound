    titleLbl.TextSize = 28
    titleLbl.TextColor3 = Color3.fromRGB(255, 60, 60)
    titleLbl.ZIndex = 102
    titleLbl.Parent = panel
    local titleStroke = Instance.new("UIStroke", titleLbl)
    titleStroke.Color = Color3.fromRGB(255, 0, 0)
