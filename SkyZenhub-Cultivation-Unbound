local function addSection(page, title, startOpen)
    local open = startOpen and true or false
    local header = Instance.new("TextButton")
    header.Size = UDim2.new(1, -6, 0, 30)
    header.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    header.BackgroundTransparency = 0.1
    header.Font = Enum.Font.GothamBold
    header.TextSize = 13
    header.TextColor3 = Color3.fromRGB(220, 220, 225)
    header.LayoutOrder = nextOrder(page)
    header.Parent = page
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 8)
    local hs = Instance.new("UIStroke", header)
    hs.Color = GREY

    local body = Instance.new("Frame")
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.BackgroundTransparency = 1
    body.LayoutOrder = nextOrder(page)
    body.Visible = open
    body.Parent = page
    local bodyLayout = Instance.new("UIListLayout", body)
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Padding = UDim.new(0, 4)

    local function refresh()
        header.Text = (open and "▼  " or "▶  ") .. title
        body.Visible = open
    end
    refresh()
    header.MouseButton1Click:Connect(function()
        open = not open
        refresh()
    end)

    return body
end

