    if miniEv then
        btConn = miniEv.OnClientEvent:Connect(function()
            miniSeen = true
            task.spawn(function()
                task.wait(CONFIG.BT_DELAY)
                if CONFIG.ENABLED and CONFIG.BREAKTHROUGH and btId == id then
                    sendBreakthroughResult()
                end
