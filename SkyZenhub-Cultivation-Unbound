-- SCRIPT UPDATE banner
local function showUpdateBanner()
    local banner = Instance.new("Frame")
    banner.Name = "UpdateBanner"
    banner.Size = UDim2.new(0, 340, 0, 0)
    banner.Position = UDim2.new(0.5, -170, 0, 80)
    banner.BackgroundColor3 = Color3.fromRGB(20, 25, 30)
    banner.BorderSizePixel = 0
    banner.ClipsDescendants = true
    banner.ZIndex = 60
    banner.Parent = gui
    Instance.new("UICorner", banner).CornerRadius = UDim.new(0, 10)

    local bStroke = Instance.new("UIStroke", banner)
    bStroke.Color = Color3.fromRGB(70, 200, 255)
    bStroke.Thickness = 1.5
    bStroke.Transparency = 0.2

    local bGrad = Instance.new("UIGradient", banner)
    bGrad.Rotation = 90
    bGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(30, 40, 55)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(12, 14, 20)),
    })

    local iconFrame = Instance.new("Frame")
    iconFrame.Size = UDim2.new(0, 36, 0, 36)
    iconFrame.Position = UDim2.new(0, 12, 0, 14)
    iconFrame.BackgroundColor3 = Color3.fromRGB(30, 60, 80)
    iconFrame.BorderSizePixel = 0
    iconFrame.ZIndex = 61
    iconFrame.Parent = banner
    Instance.new("UICorner", iconFrame).CornerRadius = UDim.new(0, 8)

    local iconTxt = Instance.new("TextLabel")
    iconTxt.Size = UDim2.new(1, 0, 1, 0)
    iconTxt.BackgroundTransparency = 1
    iconTxt.Text = "↑"
    iconTxt.Font = Enum.Font.GothamBlack
    iconTxt.TextSize = 22
    iconTxt.TextColor3 = Color3.fromRGB(120, 220, 255)
    iconTxt.ZIndex = 62
    iconTxt.Parent = iconFrame

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, -110, 0, 18)
    titleLbl.Position = UDim2.new(0, 58, 0, 12)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = "SCRIPT UPDATE"
    titleLbl.Font = Enum.Font.GothamBlack
    titleLbl.TextSize = 13
    titleLbl.TextColor3 = Color3.fromRGB(120, 220, 255)
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 61
    titleLbl.Parent = banner

    local verLbl = Instance.new("TextLabel")
    verLbl.Size = UDim2.new(1, -110, 0, 16)
    verLbl.Position = UDim2.new(0, 58, 0, 30)
    verLbl.BackgroundTransparency = 1
    verLbl.Text = SCRIPT_VERSION .. "  ·  " .. SCRIPT_UPDATED
    verLbl.Font = Enum.Font.Gotham
    verLbl.TextSize = 11
    verLbl.TextColor3 = Color3.fromRGB(180, 200, 220)
    verLbl.TextXAlignment = Enum.TextXAlignment.Left
    verLbl.ZIndex = 61
    verLbl.Parent = banner

    local okBtn = Instance.new("TextButton")
    okBtn.Size = UDim2.new(0, 60, 0, 26)
    okBtn.Position = UDim2.new(1, -72, 0, 19)
    okBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 120)
    okBtn.BorderSizePixel = 0
    okBtn.Text = "OK"
    okBtn.Font = Enum.Font.GothamBold
    okBtn.TextSize = 12
    okBtn.TextColor3 = Color3.new(1, 1, 1)
    okBtn.ZIndex = 61
    okBtn.Parent = banner
    Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0, 6)

    okBtn.MouseButton1Click:Connect(function()
        local t = TS:Create(banner, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 340, 0, 0)})
        t:Play()
        t.Completed:Connect(function() banner:Destroy() end)
    end)

    TS:Create(banner, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 340, 0, 62)}):Play()
end

task.spawn(showUpdateBanner)
