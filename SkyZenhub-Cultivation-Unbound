    return string.find(m.Name, "Disciple", 1, true) ~= nil
end

local function npcScan()
    local found = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Humanoid") then
            local m = d.Parent
            if m and npcIsCandidate(m) then found[m] = true end
        elseif d:IsA("Model") and string.find(d.Name, "Disciple", 1, true) and npcIsCandidate(d) then
            found[d] = true
        end
    end
    if getnilinstances then
        local ok, nils = pcall(getnilinstances)
        if ok and nils then
            for _, o in ipairs(nils) do
                if npcIsCandidate(o) then found[o] = true end
            end
        end
    end
    npcCandidates = found
end

local function npcAlive(m)
    local hum = m:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then return false end
    return true
end

-- Damage otomatis dari stat player
local DAMAGE_KEYS = { "damage", "attack", "atk", "dmg", "power", "strength" }
local DAMAGE_SKIP = { "speed", "cooldown", "rate", "chance", "crit", "range", "multi", "boost" }

local function damageNameOk(name)
    local n = string.lower(name)
    for _, bad in ipairs(DAMAGE_SKIP) do
        if string.find(n, bad, 1, true) then return false end
    end
    return true
end

local function npcGetDamage()
    local holders = { LocalPlayer, LocalPlayer.Character }
    for _, key in ipairs(DAMAGE_KEYS) do
        for _, h in ipairs(holders) do
            if h then
                for k, val in pairs(h:GetAttributes()) do
                    if type(val) == "number" and val > 0 and damageNameOk(k)
                        and string.find(string.lower(k), key, 1, true) then
                        return val, k
                    end
                end
                for _, d in ipairs(h:GetDescendants()) do
                    if (d:IsA("NumberValue") or d:IsA("IntValue")) and d.Value > 0
                        and damageNameOk(d.Name)
                        and string.find(string.lower(d.Name), key, 1, true) then
                        return d.Value, d.Name
                    end
                end
            end
        end
    end
    return nil
end

-- Lingkaran range
local npcRing = nil

local function npcRingDestroy()
    if npcRing then
        pcall(function() npcRing:Destroy() end)
        npcRing = nil
    end
end

local function npcRingUpdate(myRoot)
    if not myRoot then
        if npcRing then npcRing.Adornee = nil end
        return
    end
    if not npcRing or not npcRing.Parent then
        local ring = Instance.new("CylinderHandleAdornment")
        ring.Name = "NpcKaRing"
        ring.Height = 0.15
        ring.Color3 = Color3.fromRGB(255, 60, 60)
        ring.Transparency = 0.25
        ring.AlwaysOnTop = true
        ring.ZIndex = 1
        ring.CFrame = CFrame.new(0, -2.9, 0) * CFrame.Angles(math.rad(90), 0, 0)
        ring.Adornee = myRoot
        ring.Parent = workspace.CurrentCamera
        npcRing = ring
    end
    if npcRing.Adornee ~= myRoot then npcRing.Adornee = myRoot end
    local r = CONFIG.NPC_KA_RANGE
    npcRing.Radius = r
    npcRing.InnerRadius = math.max(r - 0.6, 0)
end

local function npcNotify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Kill Aura NPC",
            Text = text,
            Duration = 4,
        })
    end)
end

local function npcLoop(id)
    local lastScan, lastDmg = 0, 0
    local dmg, src = npcGetDamage()
    if dmg then
        npcNotify("Damage: " .. tostring(dmg) .. " (stat: " .. tostring(src) .. ")")
    else
        dmg = 1
        npcNotify("Stat damage tidak ketemu, pakai damage 1")
    end

    while CONFIG.ENABLED and CONFIG.NPC_KA and npcId == id do
        if os.clock() - lastScan > 1 then
            lastScan = os.clock()
            pcall(npcScan)
        end
        if os.clock() - lastDmg > 0.5 then
            lastDmg = os.clock()
            local ok, d = pcall(npcGetDamage)
            if ok and d then dmg = d end
        end

        local char = LocalPlayer.Character
        local myRoot = char and char:FindFirstChild("HumanoidRootPart")
        local ev = getCombatEvent()

        pcall(npcRingUpdate, myRoot)

        if myRoot and ev then
            local list = {}
            for m in pairs(npcCandidates) do
                local ok, pos = pcall(function() return m:GetPivot().Position end)
                if ok and pos and npcAlive(m) then
                    local dist = (pos - myRoot.Position).Magnitude
                    if dist <= CONFIG.NPC_KA_RANGE then
                        list[#list + 1] = { inst = m, dist = dist }
                    end
                end
            end
            table.sort(list, function(a, b) return a.dist < b.dist end)

            for i = 1, math.min(#list, CONFIG.NPC_KA_MAX) do
                local target = list[i].inst
                pcall(function() ev:FireServer(target, dmg) end)
            end
        end

        task.wait() -- delay 0 (setiap frame)
    end
end

local function setKillAuraNpc(v)
    CONFIG.NPC_KA = v
    npcId = npcId + 1
    if v then
        task.spawn(npcLoop, npcId)
    else
        npcCandidates = {}
        npcRingDestroy()
    end
end

