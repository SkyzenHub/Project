    btnGlow.Color = Color3.fromRGB(255, 80, 80)
    btnGlow.Thickness = 6
    btnGlow.Transparency = 0.5
    TS:Create(btnGlow, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Transparency = 0.9, Thickness = 10}):Play()

