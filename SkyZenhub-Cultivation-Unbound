local function chestColor(name)
    local n = string.lower(name)
    for key, col in pairs(CHEST_COLORS) do
        if string.find(n, key, 1, true) then return col end
    end
    return Color3.fromRGB(255, 235, 120)
end

local function isChestName(name)
